# SERVER
NODE_ENV=development
PORT=8000

FRONTEND_URL=http://localhost:3000
# CLIENT_URL=http://localhost:3000   # optional — CORS origin phụ (nếu cần)

DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<dbname>

# JWT
JWT_SECRET_KEY=<random_hex_64_chars>

REFRESH_TOKEN_EXPIRES_IN_DAYS=7
ACCESS_TOKEN_EXPIRES_IN=15m
RESET_TOKEN_EXPIRES_IN_MINUTES=15

# GMAIL
MAIL_USER=<your_gmail>@gmail.com
MAIL_PASSWORD=<gmail_app_password>

# CLOUDINARY
CLOUDINARY_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>

# REDIS
REDIS_URL=redis://localhost:6379

# SEPAY (webhook nạp kẹo)
SEPAY_SECRET_KEY=<sepay_webhook_secret>

# BANK / VietQR
BANK_ID=<bank_bin_hoặc_mã_ngân_hàng>
BANK_ACCOUNT_NO=<số_tài_khoản_nhận>
